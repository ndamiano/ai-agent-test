# The llm-queue worker: Qwen3.8 Flash-Next on an RTX PRO 6000 (SM120), served by the Pennyroyal
# SGLang fork, plus the pull-side agent, one container.
#
# The fork at a pinned tag is the only stack measured to serve Flash-Next on a 96 GB SM120 card
# with vision (no mmproj), tool calls and a clean reasoning split (2026-09-02: 203 tok/s
# short-ctx decode, ~100 at 54K). The tag is on our fork and carries the prepacked loader
# (dump/restore of post-repack state as one flat file) over jpezzulli's release.
#
# THE IMAGE IS THE TOOLCHAIN; THE ENGINE RIDES THE VOLUME. The python env, the fork checkout and
# the sm120 kernel caches (~9.5 GB, mostly CUDA libraries that do not compress) are built here
# and exported as ONE tarball (`--target env`), which lands on every llm volume beside the
# weights as env/llm-env-<id>.tar; the entrypoint restores it into the container at boot in
# seconds off the volume, where pulling it as image layers cost 90-120 s on every host that had
# not seen the tag (measured 2026-09-03: 205 s create-to-serving cold, 110 s warm). The
# runtime stage keeps only what the JIT link line needs — nvcc, gcc-15, ninja, the CUDA dev
# headers — and symlinks the CUDA libraries into the venv the tarball will restore.
#
# Weights are NOT baked — the checkpoint rides the llm network volume at $PENNY_MODEL_DIR, as a
# PREPACKED flat file of post-repack state (docs/deploy.md). The image is code; the volume is
# weights and, now, the engine.
#
# docker/penny_cache_v6.tgz (the kernel caches + serve script) is a build input, not source: it
# lives beside the weights at s3://<llm-volume>/fastboot/ and is fetched into docker/ first.
FROM nvidia/cuda:13.3.1-cudnn-runtime-ubuntu26.04 AS builder

ARG PENNY_REPO=https://github.com/ndamiano/sglang-rtxpro6000
ARG PENNY_REF=pennyroyal-v2.1.0-prepacked1
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git python3-pip gcc-15 g++-15 libnuma-dev ninja-build cmake \
        cuda-nvcc-13-3 cuda-cudart-dev-13-3 cuda-cccl-13-3 cuda-nvrtc-dev-13-3 \
        cuda-nvml-dev-13-3 libcusparse-dev-13-3 libcublas-dev-13-3 libcusolver-dev-13-3 \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /usr/local/cuda/lib64/*_static*.a /usr/local/cuda/lib64/libcublas*static*.a

RUN pip install --break-system-packages -q uv
RUN git clone --depth 1 -b "$PENNY_REF" "$PENNY_REPO" /opt/penny

# gcc-15 identity is load-bearing: the fork's docs pin the JIT identity to it, and a different
# host compiler silently invalidates the baked kernel caches.
ENV CUDA_HOME=/usr/local/cuda CC=/usr/bin/gcc-15 CXX=/usr/bin/g++-15 CUDAHOSTCXX=/usr/bin/g++-15
RUN uv python install 3.12.13 && uv venv --python 3.12.13 /opt/venv
# setuptools/wheel_stub first: --no-build-isolation means sdists (cuda-tile) see only what is
# already in the venv, and uv seeds nothing.
RUN . /opt/venv/bin/activate && uv pip install setuptools wheel packaging wheel_stub \
    && cd /opt/penny && uv pip install --prerelease=allow --index-strategy unsafe-best-match \
        --extra-index-url https://docs.sglang.ai/whl/cu130/ --no-build-isolation -e python \
    && uv pip install nixl hf_transfer huggingface_hub \
    && uv cache clean && rm -rf /root/.cache/pip /root/.cache/uv

# sm120 kernel caches + the serve script (HiCache/NIXL stripped: the nixl wheel's backend fails
# to create; persistence returns when a from-source NIXL earns it).
ADD docker/penny_cache_v6.tgz /root/

# FlashInfer's JIT trusts only the AOT dir without rebuilding (try_load): the
# tarred JIT dir re-ninjas every fresh container (~300 s of cutlass fused_moe
# instantiation at first boot). Promote the compiled ops to AOT artifacts.
RUN set -e; AOT=/opt/venv/lib/python3.12/site-packages/flashinfer/data/aot; \
    for so in /root/cache/flashinfer/.cache/flashinfer/*/*/cached_ops/*/*.so; do \
        op=$(basename "$so" .so); mkdir -p "$AOT/$op"; cp "$so" "$AOT/$op/$op.so"; \
    done; ls "$AOT"

RUN /opt/venv/bin/python -m compileall -q /opt/venv/lib/python3.12/site-packages /opt/penny/python -j 8 || true

# The engine, as one tarball. The interpreter uv installed lives under /root/.local, so it
# rides along; the id is the tarball's own hash, and the runtime stage carries that id so a
# pod refuses to boot against a tarball built from another image.
RUN rm -rf /opt/venv/lib/python3.12/site-packages/nixl_cu12.libs \
           /opt/venv/lib/python3.12/site-packages/nixl_ep_cu12 \
    && tar -cf /env.tar /opt/venv /opt/penny /root/cache /root/.local/share/uv \
           /root/serve-nohicache.sh /root/nixl-posix.toml \
    && sha256sum /env.tar | cut -c1-12 > /env.id

FROM scratch AS env
COPY --from=builder /env.tar /env.id /

FROM nvidia/cuda:13.3.1-cudnn-runtime-ubuntu26.04
ARG DEBIAN_FRONTEND=noninteractive
# One layer: the toolkit subset the JIT needs, minus everything nothing in an LLM serving stack
# dlopens (an rm in a later layer is a whiteout and the pull still ships the bytes). The CUDA
# libraries the link line wants become symlinks into the venv the entrypoint restores — torch
# RPATHs those wheels, so the apt copies were only ever there for the link line.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git gcc-15 g++-15 libnuma-dev ninja-build cmake \
        cuda-nvcc-13-3 cuda-cudart-dev-13-3 cuda-cccl-13-3 cuda-nvrtc-dev-13-3 \
        cuda-nvml-dev-13-3 libcusparse-dev-13-3 libcublas-dev-13-3 libcusolver-dev-13-3 \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /usr/local/cuda/lib64/*_static*.a /usr/local/cuda/lib64/libcublas*static*.a \
    && rm -f /usr/lib/x86_64-linux-gnu/libcudnn* /usr/lib/x86_64-linux-gnu/libnccl* \
    && rm -f /usr/local/cuda/lib64/libnpp* /usr/local/cuda/lib64/libcufft* \
          /usr/local/cuda/lib64/libcurand* /usr/local/cuda/lib64/libnvjpeg* \
          /usr/local/cuda/lib64/libcusolverMg* \
    && cd /usr/local/cuda/lib64 \
    && SP=/opt/venv/lib/python3.12/site-packages \
    && for pair in libcublas.so.13 libcublasLt.so.13 libcusparse.so.12 libcusolver.so.12 \
                   libnvJitLink.so.13 libnvrtc.so.13; do \
        rm -f "$pair".* "$pair"; ln -s "$SP/nvidia/cu13/lib/$pair" "$pair"; \
    done \
    && rm -f libnvrtc-builtins.so* \
    && ln -s "$SP/nvidia/cu13/lib/libnvrtc-builtins.so.13.0" libnvrtc-builtins.so.13.0

ENV CUDA_HOME=/usr/local/cuda CC=/usr/bin/gcc-15 CXX=/usr/bin/g++-15 CUDAHOSTCXX=/usr/bin/g++-15

COPY --from=builder /env.id /opt/maestro/env.id
COPY src/worker /opt/maestro/src/worker
COPY src/llm_clients/__init__.py src/llm_clients/wire.py /opt/maestro/src/llm_clients/
COPY scripts/worker-llm-entrypoint.sh /opt/maestro/entrypoint.sh
RUN chmod +x /opt/maestro/entrypoint.sh

ENV PYTHONPATH=/opt/maestro/src \
    PYTHONUNBUFFERED=1 \
    SGLANG_PORT=8001 \
    PENNY_MODEL_DIR=/workspace/models/pennyroyal \
    PENNY_ENV_DIR=/workspace/env \
    TORCHINDUCTOR_CACHE_DIR=/root/cache/torchinductor \
    TRITON_CACHE_DIR=/root/cache/triton

ENTRYPOINT ["/opt/maestro/entrypoint.sh"]
