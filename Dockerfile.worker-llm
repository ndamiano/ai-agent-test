# The llm-queue GPU worker: BOTH inference engines + the pull-side agent, one container.
#
# One image, two engines, because the card is not ours to choose: RunPod satisfies gpuTypeIds by
# availability, and ninfer is compiled for sm_120a — a 5090 only. The entrypoint reads the device
# at boot and serves the artifact that card can run. An image per engine would mean a template per
# engine and a queue that can only scale onto one kind of card.
#
# ninfer is BUILT here from a pinned commit rather than taken off the volume: the volume holds
# weights, and a binary staged beside them is a second thing to keep in step with this repo.
FROM nvidia/cuda:13.1.2-devel-ubuntu24.04 AS ninfer-build

ARG NINFER_REF=455c13c9429ed853297544071b6006abd5ca7404
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates cmake g++ git libavcodec-dev libavformat-dev libavutil-dev \
        libcurl4-openssl-dev libswscale-dev ninja-build pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN git clone https://github.com/Neroued/ninfer.git /src \
    && git -C /src checkout "$NINFER_REF"
# NINFER_BUILD_APPS is the server; tools/benchmarks/tests are the parts we never run. The build
# rejects any CUDA architecture other than 120a, so this stage fails loudly rather than producing
# a binary that would fault on the card it was built for.
RUN cmake -S /src -B /build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DNINFER_BUILD_APPS=ON \
        -DBUILD_TESTING=OFF \
        -DNINFER_BUILD_BENCHMARKS=OFF \
        -DNINFER_BUILD_TOOLS=OFF \
    && cmake --build /build --parallel --target ninfer-serve


# Pinned by digest, not by tag: ggml-org publishes only rolling tags (server-cuda, full-cuda), so
# `:server-cuda` silently changes under you. This digest is llama-server build 10068 (571d0d540),
# verified to serve /v1/responses and /models in router mode.
#
# Weights are NOT baked — they come from the RunPod network volume at /workspace (see
# scripts/provision_volume.sh). The image is code; the volume is weights.
FROM ghcr.io/ggml-org/llama.cpp@sha256:b19cec9fe85f11d001f8911d87bc20a0479bfaf8ab99fd8dcef2258a4fd8c0ab

# python3 and curl ship with the base image; pip does not. requests is the worker's only dependency,
# so take the distro package rather than bootstrapping pip. The libav/libcurl runtimes are ninfer's
# (its media decoders link unconditionally, though this worker sends only text).
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3-requests libavcodec60 libavformat60 libavutil58 libswscale7 libcurl4t64 \
    && rm -rf /var/lib/apt/lists/*

# This base carries CUDA 12.8 for llama.cpp; ninfer links libcudart.so.13. Both runtimes coexist
# under one driver, so take the single .so rather than a second CUDA install.
COPY --from=ninfer-build /usr/local/cuda/lib64/libcudart.so.13* /usr/local/lib/
COPY --from=ninfer-build /build/apps/ninfer-serve /usr/local/bin/ninfer-serve
RUN ldconfig

COPY src/worker /opt/maestro/src/worker
# handlers.llm translates the canonical request into its target's dialect, so wire.py ships with
# it. Only these two files: the rest of llm_clients is control-plane code that would drag in
# pydantic and the settings manager, which this image has no reason to carry.
COPY src/llm_clients/__init__.py src/llm_clients/wire.py /opt/maestro/src/llm_clients/
COPY scripts/worker-llm-entrypoint.sh /opt/maestro/entrypoint.sh
RUN chmod +x /opt/maestro/entrypoint.sh

ENV PYTHONPATH=/opt/maestro/src \
    PYTHONUNBUFFERED=1 \
    LLAMA_PORT=8080 \
    NINFER_PORT=8090 \
    MODELS_DIR=/workspace/models/LLM \
    NINFER_MODEL=/workspace/models/ninfer/qwen3_8_27b_nvfp4.ninfer

ENTRYPOINT ["/opt/maestro/entrypoint.sh"]
