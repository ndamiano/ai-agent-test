{
  "version": "0.1",
  "genre": "rpg",
  "meta": { "title": "The Ember Crypt" },

  "characters": [
    { "id": "hero", "name": "Hero", "sprite": "hero.png" },
    { "id": "slime", "name": "Slime" },
    { "id": "skeleton", "name": "Bone Warden" },
    { "id": "elder", "name": "Village Elder", "sprite": "elder.png" }
  ],

  "backgrounds": [
    { "id": "bg_overworld", "image_file": "overworld.png" },
    { "id": "bg_crypt", "image_file": "crypt.png" },
    { "id": "bg_town", "image_file": "town.png" },
    { "id": "bg_field", "image_file": "field.png" }
  ],

  "items": [
    { "id": "potion", "name": "Healing Potion" },
    { "id": "crypt_key", "name": "Crypt Key" }
  ],

  "flags": ["learned_fire", "crypt_purified", "cleared_slimes"],
  "goal": { "flag": "crypt_purified" },

  "combat_model": "turn_based",

  "stats": [
    { "id": "hp", "default": 30, "min": 0, "max": 30, "role": "resource_depletable" },
    { "id": "mp", "default": 10, "min": 0, "max": 10, "role": "resource_regenerating" },
    { "id": "atk", "default": 5, "role": "modifier" }
  ],

  "statuses": [
    { "id": "poison", "name": "Poison", "tick": [{ "stat": "hp", "op": "damage", "formula": { "base": 2 } }] }
  ],

  "abilities": [
    { "id": "slash", "name": "Slash",
      "targeting": { "shape": "single", "faction": "enemy", "range": "melee" },
      "effects": [{ "stat": "hp", "op": "damage", "formula": { "base": 4, "scales_with": "atk", "scale": 1 } }] },

    { "id": "cleave", "name": "Cleave",
      "targeting": { "shape": "all", "faction": "enemy", "range": "melee" },
      "effects": [{ "stat": "hp", "op": "damage", "formula": { "base": 3 } }] },

    { "id": "firebolt", "name": "Firebolt",
      "cost": [{ "stat": "mp", "amount": 3 }],
      "targeting": { "shape": "single", "faction": "enemy", "range": "ranged" },
      "requires": { "flag": "learned_fire" },
      "effects": [
        { "stat": "hp", "op": "damage", "formula": { "base": 6 } },
        { "status": "poison", "duration": 3 },
        { "world": { "set_flag": "crypt_purified" } }
      ] },

    { "id": "quaff", "name": "Drink Potion",
      "requires": { "item": "potion" },
      "targeting": { "shape": "self", "faction": "self" },
      "effects": [
        { "stat": "hp", "op": "heal", "formula": { "base": 14 } },
        { "world": { "remove_item": "potion" } }
      ] },

    { "id": "curse", "name": "Curse",
      "targeting": { "shape": "single", "faction": "enemy", "range": "ranged" },
      "effects": [{ "stat": "atk", "op": "add", "formula": { "base": -2 } }] }
  ],

  "combatants": [
    { "id": "cb_hero", "character": "hero",
      "stats": [{ "stat": "hp", "value": 30 }, { "stat": "mp", "value": 10 }, { "stat": "atk", "value": 6 }],
      "abilities": ["slash", "cleave", "firebolt", "quaff"] },
    { "id": "cb_slime", "character": "slime", "stats": [{ "stat": "hp", "value": 8 }], "abilities": ["slash"] },
    { "id": "cb_slime2", "character": "slime", "stats": [{ "stat": "hp", "value": 8 }], "abilities": ["slash"] },
    { "id": "cb_skeleton", "character": "skeleton",
      "stats": [{ "stat": "hp", "value": 26 }, { "stat": "atk", "value": 7 }],
      "abilities": ["slash", "curse"] }
  ],

  "encounters": [
    { "id": "enc_slimes", "background": "bg_field",
      "combatants": [
        { "ref": "cb_hero", "faction": "player", "position": { "cell": { "x": 1, "y": 2 } } },
        { "ref": "cb_slime", "faction": "enemy", "position": { "cell": { "x": 4, "y": 1 } } },
        { "ref": "cb_slime2", "faction": "enemy", "position": { "cell": { "x": 4, "y": 3 } } }
      ],
      "victory": { "all_defeated": "enemy" },
      "defeat": { "all_defeated": "player" },
      "on_victory": { "type": "jump", "target": "node_slimes_cleared" },
      "on_defeat": { "type": "end", "ending": "game_over" } },

    { "id": "enc_boss", "background": "bg_crypt",
      "combatants": [
        { "ref": "cb_hero", "faction": "player", "position": { "cell": { "x": 1, "y": 2 } } },
        { "ref": "cb_skeleton", "faction": "enemy", "position": { "cell": { "x": 5, "y": 2 } } }
      ],
      "victory": { "all_defeated": "enemy" },
      "defeat": { "all_defeated": "player" },
      "on_victory": { "type": "jump", "target": "node_boss_win" },
      "on_defeat": { "type": "end", "ending": "game_over" } }
  ],

  "start": { "place": "overworld", "spawn": { "cell": { "x": 1, "y": 3 } } },

  "places": [
    { "id": "overworld", "kind": "world_map", "background": "bg_overworld",
      "grid": { "w": 9, "h": 7 },
      "impassable": [
        { "x": 5, "y": 0 }, { "x": 5, "y": 1 }, { "x": 5, "y": 2 },
        { "x": 5, "y": 4 }, { "x": 5, "y": 5 }, { "x": 5, "y": 6 }
      ],
      "interactables": [
        { "id": "ov_sign", "label": "Signpost", "position": { "cell": { "x": 1, "y": 1 } },
          "action": { "type": "examine", "text": "EMBER CRYPT, east past the gap. Hamlet to the south." } },
        { "id": "ov_potion", "label": "Potion", "position": { "cell": { "x": 3, "y": 1 } },
          "action": { "type": "take", "item": "potion", "text": "You pocket a healing potion." } },
        { "id": "ov_key", "label": "Key", "position": { "cell": { "x": 3, "y": 5 } },
          "action": { "type": "take", "item": "crypt_key", "text": "A rusted crypt key. The gate east will open now." } },
        { "id": "ov_slimes", "label": "Slimes!", "position": { "cell": { "x": 4, "y": 3 } },
          "action": { "type": "start_combat", "encounter": "enc_slimes", "requires": { "not": { "flag": "cleared_slimes" } } } },
        { "id": "ov_to_crypt", "label": "Crypt Gate", "position": { "cell": { "x": 7, "y": 2 } },
          "action": { "type": "move", "target": "crypt", "requires": { "item": "crypt_key" }, "spawn": { "cell": { "x": 0, "y": 2 } } } },
        { "id": "ov_to_town", "label": "To Hamlet", "position": { "cell": { "x": 1, "y": 6 } },
          "action": { "type": "move", "target": "town", "spawn": { "cell": { "x": 0, "y": 2 } } } }
      ] },

    { "id": "crypt", "kind": "interior", "background": "bg_crypt",
      "grid": { "w": 7, "h": 6 },
      "impassable": [{ "x": 2, "y": 2 }, { "x": 2, "y": 3 }, { "x": 4, "y": 0 }, { "x": 4, "y": 1 }],
      "interactables": [
        { "id": "cr_exit", "label": "Exit", "position": { "cell": { "x": 0, "y": 0 } },
          "action": { "type": "move", "target": "overworld", "spawn": { "cell": { "x": 7, "y": 2 } } } },
        { "id": "cr_rune", "label": "Fire Rune", "position": { "cell": { "x": 3, "y": 1 } },
          "action": { "type": "use", "fallback": { "text": "The rune flares. You have learned Firebolt.", "effects": [{ "set_flag": "learned_fire" }] } } },
        { "id": "cr_boss", "label": "Bone Warden", "position": { "cell": { "x": 5, "y": 2 } },
          "action": { "type": "start_combat", "encounter": "enc_boss", "requires": { "not": { "flag": "crypt_purified" } } } },
        { "id": "cr_altar", "label": "Altar", "position": { "cell": { "x": 5, "y": 4 } },
          "action": { "type": "win" } }
      ] },

    { "id": "town", "kind": "town", "background": "bg_town",
      "grid": { "w": 6, "h": 5 },
      "interactables": [
        { "id": "tn_exit", "label": "Leave", "position": { "cell": { "x": 0, "y": 0 } },
          "action": { "type": "move", "target": "overworld", "spawn": { "cell": { "x": 1, "y": 6 } } } },
        { "id": "tn_elder", "label": "Elder", "position": { "cell": { "x": 2, "y": 2 } },
          "action": { "type": "talk", "node": "node_elder" } }
      ] }
  ],

  "nodes": [
    { "id": "node_slimes_cleared",
      "lines": [{ "speaker": null, "text": "The slimes burst into harmless puddles." }],
      "end": { "type": "jump", "target": "node_slimes_done" } },
    { "id": "node_slimes_done",
      "lines": [{ "speaker": null, "text": "The road east is clear.", "effects": [{ "set_flag": "cleared_slimes" }] }],
      "end": { "type": "return" } },

    { "id": "node_boss_win",
      "lines": [{ "speaker": "skeleton", "text": "The Warden crumbles to ash.", "emotion": "worried" },
                { "speaker": null, "text": "Only the altar remains." }],
      "end": { "type": "return" } },

    { "id": "node_elder",
      "lines": [{ "speaker": "elder", "text": "The crypt's evil only yields to FIRE, traveler." }],
      "end": { "type": "menu", "choices": [
        { "text": "How do I find fire?", "target": "node_elder_fire" },
        { "text": "Farewell.", "target": "node_elder_bye" }
      ] } },
    { "id": "node_elder_fire",
      "lines": [{ "speaker": "elder", "text": "A rune deep in the crypt will teach you. Burn the Warden with it." }],
      "end": { "type": "return" } },
    { "id": "node_elder_bye",
      "lines": [{ "speaker": "elder", "text": "Walk safe." }],
      "end": { "type": "return" } }
  ]
}
