# Copy to .env and edit. Loaded by docker-compose (env_file) into the app container.
# NO real secrets in this file — .env is gitignored; .env.example is committed as a template.

# ── Server ────────────────────────────────────────────────────────────────────
# Host port published by compose (container always listens on 8000 internally).
PORT=8000
# run.py binds this inside the container. 0.0.0.0 is correct — Docker maps the port.
HOST=0.0.0.0
# MAESTRO_DEV unset == production (uvicorn reload OFF). Set to 1 ONLY for local iteration.
# MAESTRO_DEV=

# Same-origin serving (SPA + API from one process) needs NO CORS config — leave blank.
# Only set if you serve the SPA from a DIFFERENT origin (comma-separated allowlist).
MAESTRO_CORS_ORIGINS=

# ── Durable state ─────────────────────────────────────────────────────────────
# Holds runs/ + private/auth.db. MUST stay /data — the named Docker volume mounts here.
# Changing this off the volume path silently drops persistence.
WORKING_DIRECTORY=/data

# ── GPU services (run on the HOST, reached via host.docker.internal) ───────────
CONNECTOR_TYPE=lmstudio
LMSTUDIO_BASE_URL=http://host.docker.internal:1234
# The model id the inference server actually serves (llama-server --models-dir: the exact file id,
# not "local-model"). LMSTUDIO_DIALOGUE_MODEL (optional) routes prose/dialogue to a second model;
# blank = use the main model for everything.
LMSTUDIO_MODEL=local-model
LMSTUDIO_DIALOGUE_MODEL=
COMFYUI_ENDPOINT=http://host.docker.internal:8188
# Model tier — controls context budget / iterations / JSON mode. Use "small" for local models.
MODEL_CATEGORY=large
# TTS (:8880) and Trellis (:8189) are configured in settings.json (no env fallback in code today);
# they also live on the host — reach them at host.docker.internal:<port> if you wire them.

# ── Host-mounted engines (read-only bind mounts; see docker-compose.yml) ───────
# In-container path the code reads for the Ren'Py SDK. Keep = /opt/renpy (the mount target).
RENPY_SDK=/opt/renpy

# HOST paths that get bind-mounted into the container. Edit to match the prod box.
# Ren'Py 8.5.2 SDK dir on the host:
RENPY_SDK_HOST=/home/nick/renpy-8.5.2-sdk
# Godot 4 binary on the host (mounted onto /usr/local/bin/godot, found via PATH):
GODOT_BIN_HOST=/usr/local/bin/godot
# Godot export-templates dir on the host. TODO: confirm the exact path + version subdir on your box.
# Standard location is ~/.local/share/godot/export_templates/ (containing a <version>/ subdir,
# e.g. 4.3.stable/). Point this at the PARENT export_templates dir.
GODOT_TEMPLATES_HOST=/home/nick/.local/share/godot/export_templates
