// GENERATED control scaffold — never edit; gameplay lives in game.ts and its siblings.
//
// The pipeline owns this file because the frozen spec's control scheme has exactly ONE correct
// wiring — movement AND camera come from config.controls + kit.drive (one name, one coherent
// pair), generated, never model-authored. Movement runs BEFORE the hook update each frame:
// gameplay may adjust/clamp the result afterwards (terrain height, bounds), but must never
// re-wire input or undo the move wholesale.
//
// HOOK CONTRACT — game.ts must export exactly (a 3D game has NO draw — the scene renders from
// entity shape tags):
//   createState(kit: Kit): GameState                                   build the initial state
//   init(state: GameState, kit: Kit): void                             spawn entities; MUST set state.player
//   update(state: GameState, dt: number, input: Input, kit: Kit): void gameplay, runs AFTER movement
//   hud(state: GameState, kit: Kit): HudItem[]                         screen overlay (return [] for none)
// Scaffold-read state fields: state.player (required — a shape-tagged member of state.world),
// state.player.speed? (units/s, default 8).
import { createState, init as initGame, update as updateGame, hud as hudGame } from "./game.ts";

const CONFIG: Config = { width: 1280, height: 720, mode: "3d", background: "#101018", seed: 1, controls: "orbital" };

export function createGame(kit: Kit): GameObject {
  // realize() peeks config via createGame(null) before the kit exists — createState must not run then.
  if (!kit) return { config: CONFIG } as unknown as GameObject;
  const state: any = createState(kit);
  return {
    config: CONFIG,
    state,
    init(kit: Kit) {
      initGame(state, kit);
      if (!state.player) throw new Error(
        "game.ts init(state, kit) must create state.player (a shape-tagged entity spawned into " +
        "state.world) — the control scaffold steers state.player.");
{interact_init}
    },
    update(dt: number, input: Input, kit: Kit) {
{interact}
      if (!state.talk)   // movement pauses while a kit dialogue is open
        kit.drive(state.player, input, dt, state.player.speed ?? 8);
      updateGame(state, dt, input, kit);
      // a walled level: game.ts sets state.walls (kit.wallsFromTilemap rects) and the scaffold
      // keeps the player out of them — movement → gameplay → collide, like the 2D solid pass.
      if (state.walls) kit.avoidRects(state.player, state.walls);
    },
    hud(kit: Kit): HudItem[] { return [...hudGame(state, kit), ...kit.talkHud(state)]; },
  };
}
