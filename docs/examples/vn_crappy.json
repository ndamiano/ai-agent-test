{
  "version": "0.1",
  "genre": "visual_novel",
  "meta": { "title": "Three Guys Talk", "premise": "Three guys, one dim room, one dented flask." },
  "characters": [
    { "id": "al", "name": "Al" },
    { "id": "bo", "name": "Bo" },
    { "id": "cy", "name": "Cy" }
  ],
  "flags": ["told_truth", "apologized"],
  "variables": [
    { "id": "mood", "default": 0 },
    { "id": "patience", "default": 0 }
  ],
  "items": [{ "id": "flask", "name": "Flask", "examine": "A dented tin flask." }],
  "start": { "node": "n_intro" },
  "nodes": [
    {
      "id": "n_intro",
      "lines": [
        { "speaker": null, "text": "A dim room. Three guys, one dented flask." },
        { "speaker": "al", "text": "You good?" },
        { "speaker": "bo", "text": "Define \"good\".", "effects": [{ "set_var": { "var": "patience", "value": 2 } }] },
        { "speaker": "cy", "text": "He muttered, \"great,\" scrawled a back\\slash, then an 'X'.", "effects": [{ "add_var": { "var": "mood", "delta": 1 } }] }
      ],
      "end": { "type": "menu", "choices": [
        { "text": "Take the flask", "target": "n_hub", "effects": [{ "add_item": "flask" }] },
        { "text": "Ignore it", "target": "n_hub" }
      ] }
    },
    {
      "id": "n_hub",
      "lines": [{ "speaker": "al", "text": "So?" }],
      "end": { "type": "menu", "choices": [
        { "text": "Drink", "target": "n_drink", "requires": { "item": "flask" },
          "effects": [{ "remove_item": "flask" }, { "add_var": { "var": "mood", "delta": 1 } }] },
        { "text": "Confess", "target": "n_confess", "requires": { "not": { "flag": "told_truth" } },
          "effects": [{ "set_flag": "told_truth" }] },
        { "text": "Push your luck", "target": "n_luck",
          "requires": { "all": [{ "var": "mood", "op": ">", "value": 0 }, { "var": "patience", "op": ">", "value": 0 }] } },
        { "text": "Make peace", "target": "n_quiet",
          "requires": { "any": [{ "flag": "apologized" }, { "var": "mood", "op": ">", "value": 2 }] } },
        { "text": "Leave quietly", "target": "n_quiet" }
      ] }
    },
    {
      "id": "n_drink",
      "lines": [{ "speaker": "bo", "text": "Empty already.", "effects": [{ "set_flag": "apologized" }] }],
      "end": { "type": "jump", "target": "n_hub" }
    },
    {
      "id": "n_confess",
      "lines": [{ "speaker": "cy", "text": "Bold.", "effects": [{ "clear_flag": "apologized" }] }],
      "end": { "type": "menu", "choices": [
        { "text": "Stand tall", "target": "n_quiet", "requires": { "var": "mood", "op": ">", "value": { "var": "patience" } } },
        { "text": "Crumble", "target": "n_bad" }
      ] }
    },
    {
      "id": "n_luck",
      "lines": [{ "speaker": null, "text": "You press. Silence presses back.", "effects": [{ "add_var": { "var": "mood", "delta": -1 } }] }],
      "end": { "type": "return" }
    },
    { "id": "n_quiet", "lines": [{ "speaker": null, "text": "Fine. For now." }], "end": { "type": "end", "ending": "quiet" } },
    { "id": "n_bad", "lines": [{ "speaker": "al", "text": "Figures." }], "end": { "type": "end", "ending": "bad" } }
  ]
}
