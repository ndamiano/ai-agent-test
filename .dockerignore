# Build context excludes — keep the image small and never bake local state/secrets.
.git/
.githooks/

# Python
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.ruff_cache/

# Frontend (source is copied for the node build stage; these are rebuilt/ignored)
frontend/node_modules/
frontend/dist/

# Runtime: the toolchain is npm-ci'd in its own stage (platform binaries), and games/ is local
# staged build output (gigabytes) — the container gets a named volume there instead.
runtime/node_modules/
runtime/games/

# Local state + secrets — must never enter the image (durable state lives on the /data volume)
outputs/
data/
src/config/settings.json

# Scratch / editor / OS
*.log
.env
.DS_Store
scratchpad/
