# The mesh-queue GPU worker: TRELLIS.2 (tools/trellis_server.py) + the pull-side agent, one
# container.
#
# Base matches the home-verified TRELLIS stack exactly (torch 2.9.1+cu128, triton 3.5.1). The
# CUDA extensions are compiled in a devel stage against TORCH_CUDA_ARCH_LIST=12.0 (Blackwell,
# the only card class this runs on) and shipped as wheels into the runtime image — the runtime
# stage needs no compiler and no git. Weights come from the RunPod network volume
# (provision_volume.sh: /workspace/trellis2-weights + /workspace/hf-cache); the image is code.

FROM pytorch/pytorch:2.9.1-cuda12.8-cudnn9-devel AS builder

RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

ENV PIP_BREAK_SYSTEM_PACKAGES=1 \
    TORCH_CUDA_ARCH_LIST=12.0 \
    MAX_JOBS=4

# TRELLIS.2 pinned by SHA (full 40 chars: GitHub refuses fetch-by-abbreviated-sha). The repo is
# both the extension source (o-voxel lives in-tree) and the runtime library the server imports.
ARG TRELLIS_SHA=75fbf0183001ed9876c8dbb35de6b68552ee08bd
COPY scripts/trellis2-sdpa-dinov3.patch /tmp/trellis2.patch
RUN git init /opt/TRELLIS2 \
    && cd /opt/TRELLIS2 \
    && git remote add origin https://github.com/microsoft/TRELLIS.2 \
    && git fetch --depth 1 origin ${TRELLIS_SHA} \
    && git checkout FETCH_HEAD \
    # o-voxel vendors Eigen as a submodule; without it its wheel build dies on Eigen/Dense.
    # (GitLab permits fetch-by-SHA, so --depth 1 works here.)
    && git submodule update --init --depth 1 o-voxel/third_party/eigen \
    # The home-verified patch set: sdpa backends for sparse full/windowed attention (upstream
    # only knows xformers/flash-attn; the server forces sdpa) + the transformers DINOv3
    # module layout (.model.layer).
    && git apply /tmp/trellis2.patch

# Every CUDA extension setup.sh installs, wheeled instead of installed: nvdiffrast v0.4.0,
# nvdiffrec (renderutils branch), CuMesh + FlexGEMM (recursive), the in-repo o-voxel, plus
# utils3d at the SHA setup.sh pins (pure python, wheeled here so runtime needs no git).
# flash-attn is skipped on purpose — trellis_server.py forces sdpa.
RUN pip install --no-cache-dir ninja \
    && mkdir /wheels /ext \
    && git clone -b v0.4.0 --depth 1 https://github.com/NVlabs/nvdiffrast.git /ext/nvdiffrast \
    && git clone -b renderutils --depth 1 https://github.com/JeffreyXiang/nvdiffrec.git /ext/nvdiffrec \
    && git clone --recursive --depth 1 https://github.com/JeffreyXiang/CuMesh.git /ext/CuMesh \
    && git clone --recursive --depth 1 https://github.com/JeffreyXiang/FlexGEMM.git /ext/FlexGEMM \
    && pip wheel --no-build-isolation --no-deps -w /wheels \
        /ext/nvdiffrast /ext/nvdiffrec /ext/CuMesh /ext/FlexGEMM /opt/TRELLIS2/o-voxel \
        "git+https://github.com/EasternJournalist/utils3d.git@9a4eb15e4021b67b12c460c7057d642626897ec8"


FROM pytorch/pytorch:2.9.1-cuda12.8-cudnn9-runtime

# curl for the entrypoint's health poll + best-effort pod self-terminate; gcc because triton
# JIT-compiles flex_gemm's kernels at first use and needs a host C compiler.
RUN apt-get update && apt-get install -y --no-install-recommends curl gcc \
    && rm -rf /var/lib/apt/lists/*

ENV PIP_BREAK_SYSTEM_PACKAGES=1

COPY --from=builder /opt/TRELLIS2 /opt/TRELLIS2
COPY --from=builder /wheels /wheels

# setup.sh --basic minus what only the demo/training paths need (gradio, tensorboard), plus the
# server's own deps (fastapi/uvicorn) and the worker's (requests). Plain pillow, not pillow-simd:
# simd needs a compiler and libjpeg-dev here for no measurable win on this path.
# The wheels go in --no-deps: o_voxel declares `utils3d @ git+...`, which would drag git into
# the runtime image — the utils3d wheel is already in /wheels and the rest is listed explicitly.
# transformers/timm/einops/kornia pinned to the home-verified stack: transformers 5.14 renamed
# DINOv3ViT internals TRELLIS reaches into ('DINOv3ViTModel' object has no attribute 'layer').
RUN pip install --no-cache-dir --no-deps /wheels/*.whl \
    && pip install --no-cache-dir \
        imageio imageio-ffmpeg tqdm easydict opencv-python-headless trimesh \
        transformers==5.13.0 timm==1.0.27 einops==0.8.2 kornia==0.8.3 \
        pandas lpips zstandard pillow fastapi uvicorn requests \
        plyfile scipy moderngl \
    && rm -rf /wheels

COPY src/worker /opt/maestro/src/worker
COPY src/tools/trellis_server.py /opt/maestro/src/tools/trellis_server.py
COPY scripts/worker-mesh-entrypoint.sh /opt/maestro/entrypoint.sh
RUN chmod +x /opt/maestro/entrypoint.sh

# No EXPOSE: the TRELLIS server binds 127.0.0.1 and the agent dials OUT — a reachable
# inference server is an unauthenticated GPU.
# Hard-offline: after provisioning, a pod NEVER talks to HuggingFace (their gating decisions
# must not be able to break us). Configs reference local /workspace paths; these flags make any
# stray hub-name lookup fail fast instead of calling out.
ENV PYTHONPATH=/opt/maestro/src \
    PYTHONUNBUFFERED=1 \
    TRELLIS_PORT=8189 \
    TRELLIS_REPO=/opt/TRELLIS2 \
    TRELLIS_WEIGHTS=/workspace/trellis2-weights \
    HF_HOME=/workspace/hf-cache \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    TRITON_CACHE_DIR=/workspace/triton-cache

# Build-time smoke: the exact interpreter the server runs under can import the CUDA stack.
RUN python -c "import torch, triton"

ENTRYPOINT ["/opt/maestro/entrypoint.sh"]
