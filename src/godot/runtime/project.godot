; Maestro Godot runtime — a static project that interprets game.json (the Game IR).
; One engine for every game; nothing is code-generated per game.

config_version=5

[application]

config/name="Maestro Game"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.2")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
