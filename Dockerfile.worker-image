# The image-queue GPU worker: ComfyUI + the RMBG node + the pull-side agent, one container.
#
# Base matches the home box exactly (torch 2.10.0+cu130) — the only configuration the sprite
# workflow has ever run on. Weights come from the RunPod network volume; the image is code.
FROM pytorch/pytorch:2.10.0-cuda13.0-cudnn9-runtime

RUN apt-get update && apt-get install -y --no-install-recommends git curl \
    && rm -rf /var/lib/apt/lists/*

# The base image installs torch into the system python, which Debian marks externally-managed.
# Everything here goes to that same interpreter on purpose — a venv would shadow the CUDA build.
ENV PIP_BREAK_SYSTEM_PACKAGES=1

# Pinned to the commit the home box actually SERVES from — /home/nick/comfy/mess-with-comfy, not
# the ComfyUI checkout beside it. Both symlink models/ to the same tree, so only the code differs.
# Full 40-char sha: GitHub refuses fetch-by-abbreviated-sha.
ARG COMFY_SHA=a1c434eb65113673c483a922e84cb0493622b3a3
RUN git init /opt/ComfyUI \
    && cd /opt/ComfyUI \
    && git remote add origin https://github.com/comfyanonymous/ComfyUI \
    && git fetch --depth 1 origin ${COMFY_SHA} \
    && git checkout FETCH_HEAD
RUN pip install --no-cache-dir -r /opt/ComfyUI/requirements.txt

# Only the BiRefNet path of this node is used (workflow node 47, class BiRefNetRMBG). Its siblings
# want groundingdino/segment-anything/onnxruntime; the node's loader try/excepts per file, so those
# modules just skip and the ~2 GB of dependencies stay out of the image. opencv is headless to avoid
# pulling libGL into a container with no display.
# timm is NOT in the node's requirements and nothing in the repo imports it: the node execs
# birefnet.py DOWNLOADED FROM HUGGINGFACE at inference time, and that file imports timm. So it is a
# runtime dep no requirements file can reveal — installing it here is the only way it lands.
ARG RMBG_SHA=7f0668e2f5127c0fbf11e346b33ce45d6dc34bf7
RUN git init /opt/ComfyUI/custom_nodes/ComfyUI-RMBG \
    && cd /opt/ComfyUI/custom_nodes/ComfyUI-RMBG \
    && git remote add origin https://github.com/1038lab/ComfyUI-RMBG \
    && git fetch --depth 1 origin ${RMBG_SHA} \
    && git checkout FETCH_HEAD \
    && pip install --no-cache-dir opencv-python-headless "huggingface-hub>=0.19.0" timm

# The RMBG node resolves its weights as folder_paths.models_dir/RMBG/BiRefNet and ignores
# extra_model_paths.yaml, so ComfyUI's models dir has to BE the volume path. Dangling until the
# volume mounts at run time. Outputs/temp stay on container disk — the volume holds weights only.
RUN rm -rf /opt/ComfyUI/models && ln -s /workspace/comfy/models /opt/ComfyUI/models

RUN pip install --no-cache-dir requests
COPY src/worker /opt/maestro/src/worker
COPY scripts/worker-image-entrypoint.sh /opt/maestro/entrypoint.sh
RUN chmod +x /opt/maestro/entrypoint.sh

ENV PYTHONPATH=/opt/maestro/src \
    PYTHONUNBUFFERED=1 \
    COMFY_PORT=8188

ENTRYPOINT ["/opt/maestro/entrypoint.sh"]
