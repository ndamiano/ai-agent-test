{
  "ck": {"class_type": "CheckpointLoaderSimple",
         "inputs": {"ckpt_name": "DreamShaperXL_Turbo_v2_1.safetensors"}},
  "dd": {"class_type": "DifferentialDiffusion", "inputs": {"model": ["ck", 0]}},
  "li": {"class_type": "LoadImage", "inputs": {"image": ""}},
  "lm": {"class_type": "LoadImage", "inputs": {"image": ""}},
  "i2m": {"class_type": "ImageToMask", "inputs": {"image": ["lm", 0], "channel": "red"}},
  "p": {"class_type": "CLIPTextEncode", "inputs": {"text": "", "clip": ["ck", 1]}},
  "n": {"class_type": "CLIPTextEncode", "inputs": {"text": "", "clip": ["ck", 1]}},
  "ve": {"class_type": "VAEEncode", "inputs": {"pixels": ["li", 0], "vae": ["ck", 2]}},
  "slm": {"class_type": "SetLatentNoiseMask",
          "inputs": {"samples": ["ve", 0], "mask": ["i2m", 0]}},
  "k": {"class_type": "KSampler",
        "inputs": {"seed": 21, "steps": 8, "cfg": 2.5, "sampler_name": "dpmpp_sde",
                   "scheduler": "karras", "denoise": 0.55, "model": ["dd", 0],
                   "positive": ["p", 0], "negative": ["n", 0], "latent_image": ["slm", 0]}},
  "vd": {"class_type": "VAEDecode", "inputs": {"samples": ["k", 0], "vae": ["ck", 2]}},
  "s": {"class_type": "SaveImage",
        "inputs": {"images": ["vd", 0], "filename_prefix": "scene_terrain"}}
}
