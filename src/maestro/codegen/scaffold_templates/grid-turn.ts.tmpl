// GENERATED control scaffold — never edit; gameplay lives in game.ts and its siblings.
//
// The pipeline owns this file because the frozen spec's control scheme has exactly ONE correct
// wiring — movement here is generated, never model-authored. Movement runs BEFORE the hook update
// each frame (one cell per key PRESS — turn-based): gameplay reacts to the new position afterwards
// (take the enemies' turn, resolve pickups), but must never re-wire input or undo the move.
//
// HOOK CONTRACT — game.ts must export exactly:
//   createState(kit: Kit): GameState                                   build the initial state
//   init(state: GameState, kit: Kit): void                             spawn entities; MUST set state.player
//   update(state: GameState, dt: number, input: Input, kit: Kit): void gameplay, runs AFTER movement
//   hud(state: GameState, kit: Kit): HudItem[]                         screen overlay (return [] for none)
// Scaffold-read state fields: state.player (required), state.cell? (px per cell, default 32), and
// state.passable?(cx: number, cy: number): boolean (cell walkability; absent = every cell passable).
// state.moved is set true on the frame the player stepped — drive the enemies' turn off it.
// Entities tagged `solid: true` get pair separation (no solidAt: walls are gridMove's passable job).
import { createState, init as initGame, update as updateGame, hud as hudGame } from "./game.ts";

const CONFIG: Config = { width: 960, height: 540, mode: "2d", background: "#111", seed: 1 };

export function createGame(kit: Kit): GameObject {
  // realize() peeks config via createGame(null) before the kit exists — createState must not run then.
  if (!kit) return { config: CONFIG } as unknown as GameObject;
  const state: any = createState(kit);
  return {
    config: CONFIG,
    state,
    init(kit: Kit) {
{interact_init}
      initGame(state, kit);
      if (!state.player) throw new Error(
        "game.ts init(state, kit) must create state.player (spawn it into state.world) — " +
        "the control scaffold steers state.player.");
    },
    update(dt: number, input: Input, kit: Kit) {
{interact}
      state.moved = false;
      if (!state.talk) {   // movement pauses while a kit dialogue is open
        const cell: number = state.cell ?? 32;
        const pass = state.passable ?? ((cx: number, cy: number) => true);
        if (input.pressed("ArrowLeft") || input.pressed("a")) state.moved = kit.gridMove(state.player, -1, 0, cell, pass);
        else if (input.pressed("ArrowRight") || input.pressed("d")) state.moved = kit.gridMove(state.player, 1, 0, cell, pass);
        else if (input.pressed("ArrowUp") || input.pressed("w")) state.moved = kit.gridMove(state.player, 0, -1, cell, pass);
        else if (input.pressed("ArrowDown") || input.pressed("s")) state.moved = kit.gridMove(state.player, 0, 1, cell, pass);
      }
      updateGame(state, dt, input, kit);
      // Order is LAW: movement → hook update → collide. Pair separation only — cell walkability
      // already belongs to gridMove's passable, so no solidAt here (a tile pushout would fight the
      // cell snap); this just unstacks solid entities sharing a cell.
      kit.collideWorld(state.world ?? []);
    },
    hud(kit: Kit): HudItem[] { return [...hudGame(state, kit), ...kit.talkHud(state)]; },
  };
}
