# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Environment
.env
.venv/
env/
venv/

# IDE
.vscode/
.idea/

# Config
src/config/api_keys.py
src/config/settings.json

# Build data
output/

# Logs
logs/
*.log

# Database
data/

# Outputs from our AI
outputs/

# Pipeline run outputs (generated artifacts and distribution builds)
runs/
*-dists/

# Pipeline dev inputs (local test data, not source)
pipeline_inputs/

# RenPy template binary assets (copy from any SDK-generated project)
src/pipelines/*/renpy_templates/**/*.png

# Compiled/generated game build outputs (regenerable). CAUTION: this bare rule silently untracks
# ANY source dir named build/ — never name one that.
build/

# Staged games (runtime/games/<run_id>/) — local build output, republished by staging on demand.
runtime/games/

# node deps (runtime/decimate.mjs: gltf-transform, meshoptimizer)
node_modules/

scratchpad/
eval
